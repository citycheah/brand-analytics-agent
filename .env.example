# =============================================================================
# Brand Analytics AI Agent — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your values. Never commit `.env` to git.

# --- 1. Google Cloud & Vertex AI / Gemini Configuration ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# --- 2. Database & Query Guardrails ---
# Set DATA_BACKEND=local to run 100% offline/locally against `data/synthetic_ad_occurrences.parquet`
# Set DATA_BACKEND=bigquery to run against your enterprise Google Cloud BigQuery table
DATA_BACKEND=local
LOCAL_STORAGE_DIR=local_storage
BQ_TABLE_NAME=your-gcp-project-id.brand_analytics.competitive_ad_occurrences
BQ_BATCH_THRESHOLD_DAYS=180
BQ_MAX_BYTES_BILLED=200000000000
SUPPORTED_COUNTRIES="Argentina;Australia;Austria;Belgium;Brazil;Canada;Chile;Colombia;Czech Republic;Denmark;Egypt;Finland;France;Germany;Greece;Hong Kong;Hungary;India;Indonesia;Ireland;Israel;Italy;Japan;Korea, Republic of;Kuwait;Lithuania;Malaysia;Mexico;Netherlands;New Zealand;Norway;Philippines;Poland;Portugal;Qatar;Romania;Saudi Arabia;Singapore;South Africa;Spain;Sweden;Switzerlands;Taiwan, Province of China;Thailand;Turkey;United Arab Emirates;United Kingdom;United States;Vietnam"

# --- 3. Storage, Reports & Creative Verification ---
LOGS_BUCKET_NAME=your-gcs-logs-and-extracts-bucket
LOCAL_DEV_WRITE=True
FEASIBILITY_THRESHOLDS_JSON={"default": {"spend": 4500, "impressions": 600000}}
VERIFY_CREATIVES_BATCH_SIZE=5
VERIFY_CREATIVES_CONCURRENCY_LIMIT=5
MAX_CREATIVE_VERIFICATIONS_PER_BRAND=100

# --- 4. Chainlit Frontend & OAuth (Optional for Production Auth) ---
CHAINLIT_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:////tmp/data.db
ALLOWED_DOMAINS=example.com
# CHAINLIT_AUTH_SECRET=generate-with-chainlit-create-secret
# OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
